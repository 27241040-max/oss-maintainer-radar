{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/27241040-max/oss-maintainer-radar/schemas/maintainer-report.schema.json",
  "title": "OSS Maintainer Radar Report",
  "type": "object",
  "required": [
    "schema_version",
    "repository",
    "generated_at",
    "window_start",
    "open_issue_count",
    "stale_issue_count",
    "sampled_pull_request_count",
    "open_pull_request_count",
    "stale_pull_request_count",
    "label_counts",
    "stale_issues",
    "review_backlog",
    "latest_release",
    "release_notes",
    "qualification_signals",
    "risks",
    "evidence",
    "scorecard"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "repository": {
      "$ref": "#/$defs/repository"
    },
    "generated_at": {
      "type": "string"
    },
    "window_start": {
      "type": [
        "string",
        "null"
      ]
    },
    "open_issue_count": {
      "type": "integer",
      "minimum": 0
    },
    "stale_issue_count": {
      "type": "integer",
      "minimum": 0
    },
    "sampled_pull_request_count": {
      "type": "integer",
      "minimum": 0
    },
    "open_pull_request_count": {
      "type": "integer",
      "minimum": 0
    },
    "stale_pull_request_count": {
      "type": "integer",
      "minimum": 0
    },
    "label_counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "stale_issues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/work_item"
      }
    },
    "review_backlog": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/work_item"
      }
    },
    "latest_release": {
      "anyOf": [
        {
          "$ref": "#/$defs/release"
        },
        {
          "type": "null"
        }
      ]
    },
    "release_notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "qualification_signals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "$ref": "#/$defs/evidence"
    },
    "scorecard": {
      "$ref": "#/$defs/scorecard"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "repository": {
      "type": "object",
      "required": [
        "full_name",
        "url",
        "description",
        "stars",
        "forks",
        "open_issues",
        "default_branch",
        "archived"
      ],
      "properties": {
        "full_name": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "stars": {
          "type": "integer",
          "minimum": 0
        },
        "forks": {
          "type": "integer",
          "minimum": 0
        },
        "open_issues": {
          "type": "integer",
          "minimum": 0
        },
        "default_branch": {
          "type": "string"
        },
        "archived": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "work_item": {
      "type": "object",
      "required": [
        "number",
        "title",
        "url",
        "age_days",
        "labels"
      ],
      "properties": {
        "number": {
          "type": "integer"
        },
        "title": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "age_days": {
          "type": "integer",
          "minimum": 0
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "release": {
      "type": "object",
      "required": [
        "name",
        "tag_name",
        "url",
        "draft",
        "prerelease",
        "published_at"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "tag_name": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "draft": {
          "type": "boolean"
        },
        "prerelease": {
          "type": "boolean"
        },
        "published_at": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": [
        "monthly_downloads",
        "dependents",
        "ecosystem_importance",
        "maintainer_responsibilities",
        "usage_notes",
        "source_urls"
      ],
      "properties": {
        "monthly_downloads": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "dependents": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "ecosystem_importance": {
          "type": "string"
        },
        "maintainer_responsibilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "usage_notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source_urls": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "scorecard": {
      "type": "object",
      "required": [
        "score",
        "total",
        "risk_count",
        "dimensions"
      ],
      "properties": {
        "score": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "risk_count": {
          "type": "integer",
          "minimum": 0
        },
        "dimensions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/scorecard_dimension"
          }
        }
      },
      "additionalProperties": false
    },
    "scorecard_dimension": {
      "type": "object",
      "required": [
        "name",
        "points",
        "max_points",
        "detail"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "points": {
          "type": "integer",
          "minimum": 0
        },
        "max_points": {
          "type": "integer",
          "minimum": 0
        },
        "detail": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
